<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS front-end for the Lepra Stack portal, so the app is reachable on the
  standard web ports (80/443) with no port number in the URL.

  This folder is never served: every request is proxied to the Next.js
  portal on 127.0.0.1:5174, which itself proxies /dimple-app, /livelihood-app,
  /telemedicine-app and /telemedicine-api to their own internal services.

  Requires: ARR (installed) + system.webServer/proxy enabled at apphost (already on).
-->
<configuration>

  <!-- The machine-wide .NET root web.config sets identity impersonate="true", which is
       invalid under the Integrated pipeline and 500.24s the site. Nothing here is
       ASP.NET, so switch it off locally rather than touching the shared file. -->
  <system.web>
    <identity impersonate="false" />
  </system.web>

  <system.webServer>

    <rewrite>
      <rules>
        <rule name="Proxy to Lepra Stack portal" stopProcessing="true">
          <match url="(.*)" />
          <!-- ARR's proxy rewrites X-Forwarded-Host to the internal target (127.0.0.1:5174)
               by default, which breaks Next.js's built-in Server Actions origin check (it
               compares x-forwarded-host against the browser's origin header and rejects the
               request if they don't match). Explicitly forward the original public host/proto
               the client actually used instead. -->
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5174/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the app's own error responses through instead of replacing them with IIS pages. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Default 30MB cap is too small for the DIMPLE foot-measurement upload
         (6 full-resolution phone camera photos in one multipart request can
         easily exceed that). Raised to 150MB. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="157286400" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
