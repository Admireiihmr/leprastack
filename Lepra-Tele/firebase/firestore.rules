// Minimal rules: all reads/writes go through the FastAPI backend using the
// admin SDK, which bypasses these rules. Client-side Firestore access is
// disabled by default to keep PHI behind the backend's role checks.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
